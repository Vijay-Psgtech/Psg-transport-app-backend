PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/psg_transport
CLIENT_URL=http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081
# Keep strict for same-site deployments; use none only for HTTPS cross-site web clients.
REFRESH_COOKIE_SAME_SITE=strict
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Optional local demo-account password. Never use a shared password in production.
# DEMO_ACCOUNT_PASSWORD=
